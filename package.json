    "@tarojs/plugin-platform-h5": "4.3.1",
    "@tarojs/plugin-platform-tt": "4.3.1",
    "@tarojs/plugin-platform-weapp": "4.3.1",
    "@tarojs/runtime": "4.3.1",
    "@tarojs/shared": "4.3.1",
    "@tarojs/taro": "4.3.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@graphql-codegen/cli": "^7.4.6",
